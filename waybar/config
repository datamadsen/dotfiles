{
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 36,
  "reload_style_on_change": true,
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "hyprland/window"
  ],
  "modules-right": [
    "custom/media",
    "custom/trackpad",
    "privacy",
    "idle_inhibitor",
    // "bluetooth",
    "custom/network",
    "custom/audio",
    "custom/cpu",
    "battery",
    "custom/notification",
    "custom/theme",
    "custom/clock",
    "custom/hostname"
  ],
  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{icon}",
    "format-icons": {
      "default": "",
      "1": "",
      "2": "󰖟",
      "3": "",
      "4": "",
      "5": "󰻞",
      "6": "6",
      "7": "7",
      "8": "8",
      "9": "9"
    },
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": []
    }
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 80,
    "separate-outputs": true,
    "rewrite": {
      "(.*) - Chromium": "$1",
      "(.*) - Google Chrome": "$1",
      "(.*) — Mozilla Firefox": "$1",
      "(.*) - Visual Studio Code": "$1",
      "(.*) - Sublime Text": "$1"
    }
  },
  "custom/cpu": {
    "exec": "~/.config/waybar/cpu.py",
    "return-type": "json",
    "format": "{}",
    "format-alt": "{alt}",
    "format-alt-click": "click-right",
    "on-click": "alacritty -e btop",
    "tooltip": true
  },
  "custom/clock": {
    "exec": "~/.config/waybar/clock.py",
    "return-type": "json",
    "format": "{}",
    "format-alt": "{alt}",
    "format-alt-click": "click-right",
    "on-click": "~/.config/waybar/fastmail-calendar.sh",
    "tooltip": true
  },
  "custom/network": {
    "exec": "~/.config/waybar/net.py",
    "return-type": "json",
    "format": "{}",
    "format-alt": "{alt}",
    "format-alt-click": "click-right",
    "on-click": "alacritty --class=Impala -e impala",
    "tooltip": true
  },
  "battery": {
    "format": "{capacity}% {icon}",
    "format-discharging": "{icon}",
    "format-charging": "{icon}",
    "format-plugged": "",
    "format-icons": {
      "charging": [
        "󰢜",
        "󰂆",
        "󰂇",
        "󰂈",
        "󰢝",
        "󰂉",
        "󰢞",
        "󰂊",
        "󰂋",
        "󰂅"
      ],
      "default": [
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
      ]
    },
    "format-full": "󰂅",
    "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
    "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
    "interval": 5,
    "states": {
      "warning": 20,
      "critical": 10
    }
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-connected": "",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "alacritty --class=Bluetooth -e bluetoothctl"
  },
  "custom/audio": {
    "exec": "~/.config/waybar/audio.py",
    "return-type": "json",
    "format": "{}",
    "on-click": "alacritty --class=Wiremix -e wiremix",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-middle": "~/.config/waybar/audio.py --cycle-output",
    "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
    "tooltip": true
  },
  "privacy": {
    "icon-spacing": 4,
    "icon-size": 14,
    "transition-duration": 250,
    "modules": [
      { "type": "screenshare" },
      { "type": "audio-in" }
    ]
  },
  "custom/media": {
    "exec": "~/.config/waybar/media.py",
    "return-type": "json",
    "format": "{}",
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-scroll-up": "playerctl volume 0.05+",
    "on-scroll-down": "playerctl volume 0.05-",
    "tooltip": true
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰛊"
    },
    "tooltip-format-activated": "Screen stays awake\nclick to allow idle lock again",
    "tooltip-format-deactivated": "Idle lock active\nclick to keep the screen awake"
  },
  "custom/trackpad": {
    "exec": "~/.config/waybar/trackpad-status.sh",
    "return-type": "json",
    "interval": "once",
    "signal": 1,
    "on-click": "~/.config/hypr/scripts/trackpad-toggle.sh",
    "tooltip": true
  },
  "custom/notification": {
    "exec": "swaync-client -swb",
    "return-type": "json",
    "escape": true,
    "format": "{icon}",
    "format-icons": {
      "notification": "󱅫",
      "none": "",
      "dnd-notification": "󰂛",
      "dnd-none": "󰂛",
      "inhibited-notification": "󱅫",
      "inhibited-none": "",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰂛"
    },
    "tooltip-format": "{} notifications",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw"
  },
  "custom/theme": {
    "exec": "~/.config/waybar/theme.py",
    "return-type": "json",
    "interval": "once",
    "signal": 10,
    "format": "{}",
    "on-click": "~/.config/waybar/theme.py --pick",
    "on-click-right": "farv next",
    "on-click-middle": "farv random",
    "on-scroll-up": "farv background next",
    "on-scroll-down": "farv background prev",
    "tooltip": true
  },
  "custom/hostname": {
    "exec": "~/.config/waybar/host.py",
    "return-type": "json",
    "format": "{}",
    "on-click": "~/.config/waybar/host.py --click",
    "tooltip": true
  }
}
