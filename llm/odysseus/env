# Odysseus (PewDiePie's self-hosted AI workspace) configuration.
# Installed by llm/install.sh as ~/.local/share/odysseus/.env
# Full reference: ~/.local/share/odysseus/.env.example
#
# Models are NOT served by Odysseus itself. llama-server runs on the host
# (see llm/llama-server.service) and Odysseus discovers it by scanning
# host.docker.internal on ports 8000-8020.

# Scan the Docker host for model servers (llama-server on 172.17.0.1:8012,
# which is what host.docker.internal resolves to inside the container).
LLM_HOST=host.docker.internal

# Web UI: http://localhost:7000, loopback only.
APP_BIND=127.0.0.1
APP_PORT=7000
ALLOWED_ORIGINS=http://localhost:7000,http://127.0.0.1:7000

# Keep auth on. The first admin password is printed in the container log on
# first boot:  docker compose logs odysseus | grep -i password
AUTH_ENABLED=true
LOCALHOST_BYPASS=false
ODYSSEUS_ADMIN_USER=admin

# Container user matches the host user so ./data stays editable.
PUID=1000
PGID=1000

# Silences a compose warning; the base file has no default for this one.
ODYSSEUS_TTS_CACHE_MAX_BYTES=524288000

# Prebuilt image instead of a local build (see docker-compose.override.yml).
ODYSSEUS_IMAGE=ghcr.io/odysseus-dev/odysseus:latest
