# User paths (highest priority)
export PATH="$PATH:$HOME/.local/bin"
export PATH="$PATH:$HOME/.local/share/bob/nvim-bin"
export PATH="$PATH:$HOME/.yarn/bin"
export PATH="$PATH:$HOME/go/bin"
export PATH="$PATH:$HOME/.npm-global/bin"

# System paths
export PATH="$PATH:/usr/local/bin"
export PATH="$PATH:/usr/bin"
export PATH="$PATH:/usr/local/sbin"
export PATH="$PATH:/usr/local/mysql/bin"
export PATH="$PATH:/usr/local/opt/ruby/bin"
export PATH="$PATH:/usr/local/lib/ruby/gems/2.6.0/bin"

export SSH_AUTH_SOCK=~/.1password/agent.sock

export PATH="$PATH:$HOME/.dotnet/tools"

# export PATH="$(yarn global bin):$PATH"

export XDG_CONFIG_HOME="$HOME/.config"

if uname -a | grep -q 'microsoft'; then
    export ASPNETCORE_ENVIRONMENT=localhost-wsl
else
    export ASPNETCORE_ENVIRONMENT=localhost
fi

case `uname` in
  Darwin)
    export DOTNET_ROOT=/usr/local/share/dotnet
  ;;
esac

# source ~/.config/tokens.sh - not on enterprise

# Local LLM stack (~/source/llm/). Clients find the Server through these; the key
# lives in ~/.config/llm/env (created by ~/source/llm/install.sh, never in the repo).
case "$(cat /etc/hostname 2>/dev/null)" in
  enterprise) export LLM_BASE_URL=http://127.0.0.1:8012; export LLM_SEARCH_URL=http://127.0.0.1:8013 ;;
  # Other hosts reach enterprise over tailscale once `tailscale serve` is set up:
  # *) export LLM_BASE_URL=https://enterprise.<tailnet>.ts.net:8012; export LLM_SEARCH_URL=https://enterprise.<tailnet>.ts.net:8013 ;;
esac
if [[ -r ~/.config/llm/env ]]; then
  set -a; source ~/.config/llm/env; set +a
fi
